# Hindi Science Explainer Generator - non-secret settings.
#
# API keys are NOT stored here. They come from environment variables, which
# always win over anything in this file:
#   ANTHROPIC_API_KEY   KIE_API_TOKEN
#   ELEVENLABS_API_KEY  YOUTUBE_CLIENT_ID    YOUTUBE_CLIENT_SECRET
#   YOUTUBE_REFRESH_TOKEN  YOUTUBE_DATA_API_KEY
#   TELEGRAM_BOT_TOKEN  TELEGRAM_CHAT_ID
# In GitHub Actions add them under Settings > Secrets > Actions.
#
# Everything below is an override of kids_video/config.py DEFAULTS. Only keys
# you actually want to change need to be listed.

pipeline:
  # Python weekday(): Mon=0 .. Sun=6
  # Current plan: Short daily + one 5-minute explainer on Sunday, ~$135/month.
  #   daily 5-min video -> move `long` to long_days: [0,1,2,3,4,5,6]  (~$386/mo)
  #   10-minute video   -> long.shot_count: 75                       (~$25/video)
  short_days: [0, 1, 2, 3, 4, 5, 6]   # a 60s Short every day
  long_days: [6]                      # the 5-minute explainer on Sunday
  language: en                        # narration language, worldwide audience
  # There is deliberately no topic list. Each run picks a fresh subject inside
  # the day's area, avoiding everything in data/history.json.
  content_rotation:
    - how_everyday_machines_work
    - physics_and_energy
    - space_and_astronomy
    - technology_and_computing
    - biology_and_the_human_body
    - medical_science
    - engineering_and_infrastructure

short:
  shot_count: 8          # 8 x 8s = ~64 seconds
  aspect_ratio: "9:16"
  veo_model: veo3_fast   # veo3_lite $0.175 | veo3_fast $0.325 | veo3 $1.275 per clip

long:
  shot_count: 38         # 38 x 8s = ~5 minutes
  aspect_ratio: "16:9"
  veo_model: veo3_fast

story:
  model: claude-opus-5

# Nothing is generated until you approve it in Telegram. The script itself
# costs a few cents; approval happens before the dollars are spent.
approval:
  enabled: true
  timeout_seconds: 3600   # no answer within an hour = skip, spend nothing

# Captions burned into the frame: white text with a black outline, no box,
# split into short cues so it reads like a caption track rather than a wall of
# text. Sizes and margins are pixels at 1080p.
subtitles:
  enabled: true
  font: "DejaVu Sans"
  words_per_cue: 5

voice:
  # One authoritative narrator. Preview options with:
  #   python run_daily_pipeline.py voices
  voice_id: "nPczCjzI2devNBz1zQrb"   # Brian - deep, resonant, neutral US accent
  model_id: eleven_multilingual_v2
  rotation: []   # explainers keep one recognisable voice, no weekday rotation

youtube:
  default_language: en
  privacy_status: public
  made_for_kids: false   # general audience, 13+; keeps comments and ads intact
  category_id: "28"      # Science & Technology

logging:
  level: INFO
  file: logs/pipeline.log
