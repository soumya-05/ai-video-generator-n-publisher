# Kids Video Generator - Daily Automation Config
# COPY THIS FILE TO config.yaml AND FILL IN YOUR API KEYS
# NEVER COMMIT config.yaml WITH REAL KEYS!

# ─── API Keys (REQUIRED) ───
api_keys:
  anthropic: "sk-ant-api03-YOUR_KEY_HERE"
  heygen: "sk_V2_hgu_YOUR_KEY_HERE"
  youtube_client_id: "YOUR_CLIENT_ID.apps.googleusercontent.com"
  youtube_client_secret: "YOUR_CLIENT_SECRET"
  youtube_refresh_token: "YOUR_REFRESH_TOKEN"
  instagram_access_token: "YOUR_LONG_LIVED_TOKEN"
  instagram_account_id: "YOUR_IG_BUSINESS_ACCOUNT_ID"
  telegram_bot_token: "YOUR_BOT_TOKEN:xxxxxxxx"
  telegram_chat_id: "YOUR_CHAT_ID"
  kie_api_token: "YOUR_KIE_AI_TOKEN"
  imgbb_api_key: "YOUR_IMGBB_KEY"
  youtube_data_api_key: "AIzaSyYOUR_KEY_HERE"

# ─── Pipeline Settings ───
pipeline:
  mode: "heygen"  # "heygen" | "3d" | "both"
  schedule_cron: "0 2 * * *"  # 2 AM UTC = 7:30 AM IST
  max_duration_seconds: 60
  target_age_group: "4-8"
  language: "hi"
  content_schedule:
    0: "nursery_rhyme"
    1: "educational"
    2: "fun_facts"
    3: "story"
    4: "poem"
    5: "lullaby"
    6: "cartoon_story"
  topics:
    nursery_rhyme:
      - "चंदा मामा दूर के"
      - "मछली जल की रानी है"
      - "आ री आ निंदिया"
      - "लकड़ी की काठी"
    educational:
      - "पानी का चक्र"
      - "गिनती 1 से 10"
      - "रंगों की दुनिया"
      - "फलों के नाम"
    fun_facts:
      - "जानवरों के रोचक तथ्य"
      - "अंतरिक्ष की अनोखी बातें"
      - "पेड़ पौधों का जादू"
    story:
      - "प्यासा कौआ"
      - "खरगोश और कछुआ"
      - "शेर और चूहा"
      - "चालाक लोमड़ी"
    poem:
      - "बारिश आई रिमझिम"
      - "तितली रानी"
      - "सूरज निकला"
      - "फूलों की बगिया"
    lullaby:
      - "सो जा राजकुमार"
      - "चंदा मामा आओ"
      - "निंदिया आ जा"
      - "आलू कचालू"
    cartoon_story:
      - "जंगल के दोस्त"
      - "परियों की कहानी"
      - "जादुई पेंसिल"
      - "उड़न खटोला"

heygen:
  avatar_id: "auto"
  voice_id: "hi-IN-Standard-A"
  video_width: 1080
  video_height: 1920

animation_3d:
  enabled: false
  aspect_ratio: "portrait"
  frames_per_shot: 10
  max_parallel_jobs: 5
  poll_interval_seconds: 5
  max_polls: 120

upload:
  youtube:
    category_id: "27"
    privacy_status: "public"
    made_for_kids: true
    default_language: "hi"
    tags: ["Shorts", "hindi", "kids", "education", "cartoon", "बच्चे", "HindiKids"]
  instagram:
    share_to_feed: true
    tags: ["Reels", "InstagramReels", "HindiKids", "KidsContent", "बच्चे"]

logging:
  level: "INFO"
  file: "logs/pipeline.log"
  max_size_mb: 10
  backup_count: 5